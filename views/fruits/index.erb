<h2>Alla frukter i butiken</h2>

<code>TODO: Skriv ut en lista (ul + li) för att visa alla frukter i databasen</code>

<ul>
    <% @fruits.each do |fruit| %>
        <li> 
            <h3><%= fruit["name"] %> </h3>
            <a href="/fruits/<%= fruit["id"]%>">
                <%= fruit["name"] %></a>
            <p><%= fruit["description"] %></p>  
        </li>
    <% end %>
</ul>
